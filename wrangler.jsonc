{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "greek-fonts",
  "routes": [
    { "pattern": "greek-fonts.withlarry.com", "custom_domain": true }
  ],
  "compatibility_date": "2026-05-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".output/public"
  },
  "observability": {
    "enabled": true
  }
}
